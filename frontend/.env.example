# ---------------------------------------------------------------------------
# Zhvillim lokal
# ---------------------------------------------------------------------------
# Lere VITE_API_BASE_URL te pa-vendosur qe kerkesat te kalojne te proxy-i i
# Vite-s ne te njejten origjine ('/api' -> backend-i). Kjo eshte rruga e
# rekomanduar lokalisht, sepse e mban CORS-in jashte loje.

# Origjina te cilen Vite i proxy-on /api dhe /storage (vetem zhvillim).
# Opsionale - nese mungon, perdoret http://127.0.0.1:8000
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Prodhim (Render Static Site)
# ---------------------------------------------------------------------------
# Ne prodhim nuk ka proxy, prandaj frontend-i duhet te dije adresen e plote te
# backend-it. Vendose te Render > Static Site > Environment.
# Pranohet me ose pa '/api' ne fund.
#
# VITE_API_BASE_URL=https://emri-i-sherbimit-tend.onrender.com
