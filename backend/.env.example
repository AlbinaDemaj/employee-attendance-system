APP_NAME="Employee Attendance"
APP_ENV=local
APP_TIMEZONE=Europe/Tirane
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=sq
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sq_AL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=employee_attendance
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173

# Attendance behaviour
ATTENDANCE_LATE_GRACE_MINUTES=0
ATTENDANCE_MANAGER_ALERT_AFTER_MINUTES=15
ATTENDANCE_AUTO_APPROVE_SICK_WITH_CERTIFICATE=false

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# ===========================================================================
# PRODHIM - Render + PostgreSQL (Supabase)
# ===========================================================================
# Vlerat me siper jane per zhvillim lokal me MySQL. Ne Render keto variabla
# vendosen te paneli i sherbimit (Environment), JO ne kete skedar dhe JO ne
# Git. Me poshte eshte lista e plote e asaj qe duhet, pa asnje sekret real.
#
# APP_NAME="Employee Attendance"
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=            # gjenerohet me: php artisan key:generate --show
# APP_URL=https://<sherbimi-api>.onrender.com
# APP_TIMEZONE=Europe/Tirane
# APP_LOCALE=sq
#
# --- Databaza (Supabase PostgreSQL) ---------------------------------------
# Supabase e jep si URI te vetme te Project Settings > Database > Connection
# string. Laravel-i e lexon direkt me DB_URL, keshtu qe mjafton kjo:
#
# DB_CONNECTION=pgsql
# DB_URL=postgresql://<perdoruesi>:<fjalekalimi>@<hosti>:5432/postgres
# DB_SSLMODE=require
#
# Nese preferohen fushat e ndara ne vend te DB_URL:
# DB_CONNECTION=pgsql
# DB_HOST=<hosti>.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=<perdoruesi>
# DB_PASSWORD=<fjalekalimi>
# DB_SSLMODE=require
#
# --- Logs ------------------------------------------------------------------
# Disku i Render-it eshte i perkohshem, prandaj logu shkon te stderr dhe
# lexohet nga paneli i Render-it.
# LOG_CHANNEL=stderr
# LOG_LEVEL=warning
#
# --- Ruajtja e gjendjes ----------------------------------------------------
# Sesionet dhe cache-i ne databaze, jo ne skedare: kontejneri rikthehet ne
# gjendjen fillestare ne cdo rinisje.
# SESSION_DRIVER=database
# CACHE_STORE=database
# QUEUE_CONNECTION=database
#
# --- Frontend --------------------------------------------------------------
# Origjina e Static Site-it te Render; pranohen disa te ndara me presje.
# FRONTEND_URL=https://<sherbimi-web>.onrender.com
# SANCTUM_STATEFUL_DOMAINS=<sherbimi-web>.onrender.com
#
# --- Te dhenat demo --------------------------------------------------------
# Vendose 'true' vetem per nje nisje te vetme, qe te mbushen llogarite demo,
# pastaj ktheje ne 'false'. Seed-i i fshin dhe i rikrijon te dhenat.
# RUN_SEEDER=false
